APP_NAME=租安AI API
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173
# 零配置演示默认使用 SQLite；部署或联调时再替换为 MySQL 8.0 地址。
DATABASE_URL=sqlite:///./rent_safe_ai.db
# DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/rent_safe_ai?charset=utf8mb4
AUTO_CREATE_TABLES=true
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20
# mock 是可复现的规则基线，并会在接口中明确显示“演示模式”。
# 使用 DeepSeek 或其他 OpenAI-compatible 服务时改为 deepseek/openai-compatible。
AI_PROVIDER=mock
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=45
# 旧版 Dify 适配配置保留，但当前不作为 V1 Provider。
DIFY_API_BASE=
DIFY_API_KEY=
DIFY_WORKFLOW_ID=
